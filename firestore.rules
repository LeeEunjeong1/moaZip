rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function currentHouseholdId() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.householdId;
    }

    function sharesCurrentHousehold(userId) {
      return exists(
          /databases/$(database)/documents/households/$(currentHouseholdId())/members/$(request.auth.uid)
        )
        && exists(
          /databases/$(database)/documents/households/$(currentHouseholdId())/members/$(userId)
        );
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
          || sharesCurrentHousehold(userId));
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid;
    }

    match /households/{householdId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == householdId;
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid
          || exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)));
      allow update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));

      match /members/{memberId} {
        allow create: if request.auth != null
          && memberId == request.auth.uid
          && request.resource.data.id == request.auth.uid
          && request.resource.data.householdId == householdId;
        allow read: if request.auth != null
          && (memberId == request.auth.uid
            || exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)));
        allow update, delete: if request.auth != null
          && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
      }

      match /assets/{assetId} {
        allow read, create, update, delete: if request.auth != null
          && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
      }
    }

    match /inviteCodes/{inviteCode} {
      allow create: if request.auth != null
        && request.resource.data.code == inviteCode
        && request.resource.data.createdBy == request.auth.uid;
      allow read: if request.auth != null;
    }

    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null
        && resource.data.id == request.auth.uid;
    }
  }
}
